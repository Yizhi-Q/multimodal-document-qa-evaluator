MLLM_BACKEND=openai
MLLM_API_KEY=replace_me
MLLM_BASE_URL=https://api.openai.com/v1
MLLM_MODEL=gpt-4.1-mini
MLLM_API_MODE=responses

# Local NVIDIA GPU backend (set MLLM_BACKEND=transformers)
MLLM_LOCAL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
MLLM_LOAD_IN_4BIT=true
MLLM_COMPUTE_DTYPE=bfloat16
MLLM_MAX_NEW_TOKENS=512
MLLM_MIN_PIXELS=200704
MLLM_MAX_PIXELS=802816
# Set an immutable Hugging Face model commit here to reproduce a previous run.
MLLM_MODEL_REVISION=main

# Experimental receipt rules; baseline reproduces the original prompt.
# label-aware-v1 / receipt-compact-v1 require string-or-null amount fields.
# Effectiveness needs a live comparison; receipt-compact-v1 returns fields only.
MLLM_RECEIPT_PROFILE=baseline
# Optional extra image request for visibly invalid amount outputs; at most one per receipt.
MLLM_RECEIPT_RECHECK=none
